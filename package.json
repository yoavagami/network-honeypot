{
  "name": "network-honeypot",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "migrate": "pnpm --filter @honeypot/db run migrate",
    "retention": "pnpm --filter @honeypot/db run retention",
    "seed": "pnpm --filter @honeypot/scripts run seed",
    "simulate": "pnpm --filter @honeypot/scripts run simulate",
    "backfill-enrichment": "pnpm --filter @honeypot/scripts run backfill-enrichment"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "@types/node": "^22.7.5"
  }
}
