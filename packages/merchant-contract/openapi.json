{
  "openapi": "3.1.0",
  "info": {
    "title": "uHoney Merchant API",
    "version": "1.0.0",
    "summary": "Detect AI agents on your store and get a verdict when someone presses Pay.",
    "description": "All verdicts are advisory: the merchant decides what to do. Integrations must fail open — if this API is slow or unavailable, the checkout continues. Compatibility: within v1, fields and enum values may be added but never renamed or removed. Ignore unknown fields and treat unknown enum values as `unknown`."
  },
  "servers": [
    { "url": "https://api.uhoney.shop", "description": "Production" },
    { "url": "https://uhoney.shop", "description": "Same API, served on the main domain" }
  ],
  "tags": [
    { "name": "Browser", "description": "Called by the uHoney tag in the visitor's browser, with the public site key." },
    { "name": "Server", "description": "Called by the merchant's server, with the secret key." }
  ],
  "paths": {
    "/v1/collect": {
      "post": {
        "tags": ["Browser"],
        "operationId": "collect",
        "summary": "Receive a beacon from the tag",
        "description": "Sent by the tag as `text/plain` JSON so browsers send it without a CORS preflight. Accepted only from the merchant's registered domains (test keys also accept `localhost` and `127.0.0.1`). Returns a session token the tag attaches to checkout forms. Beacons sent with `navigator.sendBeacon` ignore the response.",
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": { "schema": { "$ref": "#/components/schemas/CollectRequest" }, "examples": { "page": { "$ref": "#/components/examples/CollectPage" }, "payClicked": { "$ref": "#/components/examples/CollectPayClicked" } } },
            "application/json": { "schema": { "$ref": "#/components/schemas/CollectRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Beacon accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CollectResponse" }, "examples": { "ok": { "$ref": "#/components/examples/CollectResponse" } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/assess": {
      "post": {
        "tags": ["Server"],
        "operationId": "assess",
        "summary": "Get a verdict for an order at Pay",
        "description": "Call before creating or confirming the charge, with a client timeout of 300 ms. On any error or timeout, let the payment continue. The verdict is preliminary (`final: false`); the final one arrives by the `assessment.updated` webhook and from `GET /v1/assessments/{id}`. Token problems never cause an error: the verdict then rests on server-side signals, and the reasons say so.",
        "security": [{ "secretKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/MerchantHeader" },
          { "name": "Idempotency-Key", "in": "header", "required": false, "description": "Retries with the same key return the same assessment. Defaults to `order.id`. Reusing a key with a different body returns `idempotency_conflict`.", "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssessRequest" }, "examples": { "withToken": { "$ref": "#/components/examples/AssessRequest" }, "serverOnly": { "$ref": "#/components/examples/AssessRequestServerOnly" } } } } },
        "responses": {
          "200": { "description": "The verdict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Assessment" }, "examples": { "handover": { "$ref": "#/components/examples/AssessmentHandover" }, "verifiedAgent": { "$ref": "#/components/examples/AssessmentVerifiedAgent" } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/assessments/{id}": {
      "get": {
        "tags": ["Server"],
        "operationId": "getAssessment",
        "summary": "Fetch an assessment again, including its final verdict",
        "security": [{ "secretKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/MerchantHeader" },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^as_[A-Za-z0-9]{20}$" } }
        ],
        "responses": {
          "200": { "description": "The assessment", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Assessment" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "tags": ["Server"],
        "operationId": "feedback",
        "summary": "Report what really happened with an order",
        "description": "Chargebacks and confirmed cases are the ground truth that accuracy is measured against. Send exactly one of `order_id` or `assessment_id`.",
        "security": [{ "secretKey": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MerchantHeader" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackRequest" }, "examples": { "chargeback": { "$ref": "#/components/examples/FeedbackRequest" } } } } },
        "responses": {
          "202": { "description": "Recorded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackResponse" }, "examples": { "ok": { "$ref": "#/components/examples/FeedbackResponse" } } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/integration/status": {
      "get": {
        "tags": ["Server"],
        "operationId": "integrationStatus",
        "summary": "Check that the integration works",
        "description": "Every check `pass` (or `not_applicable`) means the integration is done for this key's mode (test or live). Also returns the last 5 events received, so a developer or coding agent can see what actually arrived.",
        "security": [{ "secretKey": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MerchantHeader" }],
        "responses": {
          "200": { "description": "Checklist", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IntegrationStatus" }, "examples": { "partial": { "$ref": "#/components/examples/IntegrationStatus" } } } } },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "webhooks": {
    "assessment.updated": {
      "post": {
        "summary": "The final verdict, or a change after Pay",
        "description": "Signed: the `Uhoney-Signature` header is `t=<unix seconds>,v1=<hex HMAC-SHA256 of \"<t>.<raw body>\" with your whsec_ secret>`. Reject signatures older than 5 minutes. Respond 2xx within 5 seconds; failed deliveries are retried with backoff for 24 hours. The same event `id` may arrive more than once.",
        "parameters": [{ "$ref": "#/components/parameters/SignatureHeader" }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssessmentUpdatedEvent" }, "examples": { "final": { "$ref": "#/components/examples/AssessmentUpdatedEvent" } } } } },
        "responses": { "2XX": { "description": "Received" } }
      }
    },
    "checkout.agent_started": {
      "post": {
        "summary": "An agent has reached checkout",
        "description": "Sent once per visit, when a visit that is being driven by an agent reaches a checkout step. Signed like every webhook.",
        "parameters": [{ "$ref": "#/components/parameters/SignatureHeader" }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutAgentStartedEvent" }, "examples": { "started": { "$ref": "#/components/examples/CheckoutAgentStartedEvent" } } } } },
        "responses": { "2XX": { "description": "Received" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "secretKey": { "type": "http", "scheme": "bearer", "bearerFormat": "sk_test_… or sk_live_…", "description": "Secret key from the dashboard. Server-side only: never in browser code, logs or commits." }
    },
    "parameters": {
      "MerchantHeader": { "name": "Uhoney-Merchant", "in": "header", "required": false, "description": "Optional. If sent, must equal the merchant the key belongs to, or the request is refused with `merchant_mismatch`.", "schema": { "type": "string", "pattern": "^mer_[0-9A-HJKMNP-TV-Z]{8}$" } },
      "SignatureHeader": { "name": "Uhoney-Signature", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^t=[0-9]+,v1=[0-9a-f]{64}$" } }
    },
    "responses": {
      "Error": { "description": "Error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "examples": { "invalidKey": { "$ref": "#/components/examples/ErrorInvalidKey" } } } } }
    },
    "schemas": {
      "MerchantId": { "type": "string", "pattern": "^mer_[0-9A-HJKMNP-TV-Z]{8}$", "description": "Your merchant ID. Shown in the dashboard and on every response." },
      "SessionToken": { "type": "string", "pattern": "^st_[A-Za-z0-9_-]{16,512}\\.[A-Za-z0-9_-]{16,128}$", "description": "Signed by uHoney, bound to one merchant and site key, valid for 2 hours." },
      "AssessmentId": { "type": "string", "pattern": "^as_[A-Za-z0-9]{20}$" },
      "Timestamp": { "type": "string", "format": "date-time" },
      "Driver": { "type": "string", "enum": ["human", "agent", "agent_then_human", "human_then_agent", "mixed", "unknown"], "description": "Who drove the visit. `agent_then_human`: an agent browsed and a person took over (the handover says where)." },
      "CollectRequest": {
        "type": "object",
        "required": ["site_key", "kind"],
        "properties": {
          "site_key": { "type": "string", "pattern": "^pk_(test|live)_[A-Za-z0-9]{24}$" },
          "session_token": { "$ref": "#/components/schemas/SessionToken" },
          "kind": { "type": "string", "enum": ["page", "event", "fp", "behavior", "probe"] },
          "pl": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{8,40}$", "description": "Page-view id minted by the tag." },
          "path": { "type": "string", "maxLength": 512 },
          "t": { "type": "integer", "minimum": 0, "maximum": 86400000, "description": "Milliseconds since the page loaded." },
          "v": { "type": "integer", "minimum": 1, "maximum": 99 },
          "sdk": { "type": "string", "pattern": "^[0-9A-Za-z.+-]{1,40}$" },
          "lab": { "type": "string", "maxLength": 120, "description": "Signed lab-run token from a `?lab=` link the visit landed on. Sent by the tag automatically; used for uHoney's own accuracy testing." },
          "data": { "type": "object", "description": "For `event`: `{ \"name\": \"pay_clicked\" | \"checkout_started\" | \"add_to_cart\" | \"product_viewed\", \"order_id\"?: string }`. For the page script's own kinds: its payload, opaque to merchants." }
        }
      },
      "CollectResponse": {
        "type": "object",
        "required": ["session_token", "expires_at"],
        "properties": { "session_token": { "$ref": "#/components/schemas/SessionToken" }, "expires_at": { "$ref": "#/components/schemas/Timestamp" } }
      },
      "Order": {
        "type": "object",
        "required": ["id", "amount", "currency"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "amount": { "type": "integer", "minimum": 0, "maximum": 10000000000, "description": "Minor units (cents)." },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "items": { "type": "array", "maxItems": 100, "description": "Optional. The cart lines, for the intent and legitimacy checks.", "items": { "$ref": "#/components/schemas/LineItem" } },
          "shipping": {
            "type": "object",
            "description": "Optional. Never the address itself: send your own hash of the normalized address.",
            "properties": {
              "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "address_hash": { "type": "string", "pattern": "^[A-Za-z0-9_+/=:-]{8,128}$", "description": "Any stable hash of the normalized shipping address, e.g. SHA-256 hex." },
              "new_address": { "type": "boolean", "description": "True when this customer has never shipped to this address before." }
            }
          },
          "payment": {
            "type": "object",
            "description": "Optional.",
            "required": ["method"],
            "properties": { "method": { "type": "string", "enum": ["card", "wallet", "bank_transfer", "bnpl", "gift_card", "crypto", "other"] } }
          }
        }
      },
      "LineItem": {
        "type": "object",
        "required": ["sku", "quantity", "unit_amount"],
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 128 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "As the shopper sees it." },
          "category": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$", "description": "Your own category slug, e.g. `chocolate`, `gift_card`." },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "unit_amount": { "type": "integer", "minimum": 0, "maximum": 10000000000, "description": "Price of one unit, minor units." }
        }
      },
      "AssessRequest": {
        "type": "object",
        "required": ["order", "request"],
        "properties": {
          "session_token": { "$ref": "#/components/schemas/SessionToken" },
          "stage": { "type": "string", "enum": ["pay", "checkout"], "default": "pay" },
          "order": { "$ref": "#/components/schemas/Order" },
          "intent_ref": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$", "description": "Optional. The intent this order should fulfil: an intent id or your own reference." },
          "request": {
            "type": "object",
            "description": "The visitor's request to your server, as you received it.",
            "required": ["ip", "user_agent"],
            "properties": {
              "ip": { "type": "string", "oneOf": [{ "format": "ipv4" }, { "format": "ipv6" }] },
              "user_agent": { "type": ["string", "null"], "maxLength": 1024 },
              "method": { "type": "string", "pattern": "^[A-Z]{3,7}$" },
              "path": { "type": "string", "maxLength": 2048 },
              "host": { "type": "string", "maxLength": 255 },
              "headers": {
                "type": "object",
                "maxProperties": 50,
                "description": "Lower-case names. Send at least: accept, accept-language, accept-encoding, sec-ch-ua, sec-ch-ua-mobile, sec-ch-ua-platform, sec-fetch-site, sec-fetch-mode, sec-fetch-dest, and when present signature, signature-input, signature-agent. Never send cookie or authorization.",
                "propertyNames": { "pattern": "^[a-z0-9-]{1,64}$" },
                "additionalProperties": { "type": "string", "maxLength": 4096 }
              }
            }
          }
        }
      },
      "Reason": {
        "type": "object",
        "required": ["code", "text"],
        "properties": { "code": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "text": { "type": "string" } }
      },
      "Agent": {
        "type": "object",
        "required": ["id", "operator", "verified", "verification"],
        "properties": {
          "id": { "type": "string", "description": "Stable agent id, e.g. `chatgpt-agent`, `claude-in-chrome`, `browser-use`." },
          "operator": { "type": ["string", "null"] },
          "verified": { "type": "boolean", "description": "True only when the identity is proven (signature, published IP range or confirmed reverse DNS)." },
          "verification": { "type": ["string", "null"], "enum": ["web_bot_auth", "published_ip_range", "reverse_dns", null] }
        }
      },
      "Assessment": {
        "type": "object",
        "required": ["assessment_id", "merchant_id", "livemode", "final", "created_at", "updated_at", "order", "driver", "handover", "automation_type", "agent", "score", "confidence", "reasons", "signals_used", "scorer_version", "decision", "legitimacy", "intent", "evidence_id"],
        "properties": {
          "assessment_id": { "$ref": "#/components/schemas/AssessmentId" },
          "merchant_id": { "$ref": "#/components/schemas/MerchantId" },
          "livemode": { "type": "boolean" },
          "final": { "type": "boolean", "description": "False at Pay; true once the visit has ended and the verdict cannot change." },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "updated_at": { "$ref": "#/components/schemas/Timestamp" },
          "order": { "$ref": "#/components/schemas/Order" },
          "driver": { "$ref": "#/components/schemas/Driver" },
          "handover": {
            "type": ["object", "null"],
            "required": ["page", "at"],
            "properties": { "page": { "type": ["string", "null"] }, "at": { "type": ["string", "null"], "format": "date-time" } }
          },
          "automation_type": { "type": "string", "enum": ["cloud_browser_agent", "in_browser_agent", "user_triggered_fetcher", "ai_crawler", "search_crawler", "ai_app", "browser_automation", "script", "scanner", "human", "unknown"] },
          "agent": { "oneOf": [{ "$ref": "#/components/schemas/Agent" }, { "type": "null" }] },
          "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Probability that an AI agent was involved. Not yet calibrated." },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "reasons": { "type": "array", "maxItems": 8, "items": { "$ref": "#/components/schemas/Reason" } },
          "signals_used": {
            "type": "object",
            "required": ["client", "server"],
            "properties": { "client": { "type": "boolean", "description": "The page script reported for this visit." }, "server": { "type": "boolean" } }
          },
          "scorer_version": { "type": "string" },
          "decision": { "type": "string", "enum": ["allow", "confirm", "block"], "description": "What to do with the order, from your policy: `allow` lets it through, `confirm` means your checkout gets the shopper's own approval of the cart before charging, `block` means don't take the payment. The default policy never returns `block`." },
          "legitimacy": {
            "type": "object",
            "description": "Is the agent acting for a real, authorized shopper? Not evaluated yet: `evaluated` is false and `score` is null.",
            "required": ["evaluated", "score", "reasons"],
            "properties": {
              "evaluated": { "type": "boolean" },
              "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Higher is more legitimate." },
              "reasons": { "type": "array", "maxItems": 8, "items": { "$ref": "#/components/schemas/Reason" } }
            }
          },
          "intent": {
            "type": "object",
            "description": "Does the cart match what the shopper asked for?",
            "required": ["status", "score", "violations"],
            "properties": {
              "status": { "type": "string", "enum": ["not_provided", "not_evaluated", "match", "mismatch"], "description": "`not_provided`: no `intent_ref` was sent. `not_evaluated`: sent, but not checked yet." },
              "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "violations": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/Reason" } }
            }
          },
          "evidence_id": { "type": ["string", "null"], "description": "The order's evidence record, once evidence is kept. Null for now." }
        }
      },
      "FeedbackRequest": {
        "type": "object",
        "required": ["outcome"],
        "properties": {
          "order_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "assessment_id": { "$ref": "#/components/schemas/AssessmentId" },
          "outcome": { "type": "string", "enum": ["confirmed_agent", "confirmed_human", "chargeback", "fraud", "legitimate"] },
          "note": { "type": "string", "maxLength": 500, "description": "Your own notes. No personal data." }
        },
        "oneOf": [{ "required": ["order_id"], "not": { "required": ["assessment_id"] } }, { "required": ["assessment_id"], "not": { "required": ["order_id"] } }]
      },
      "FeedbackResponse": {
        "type": "object",
        "required": ["received", "assessment_id"],
        "properties": { "received": { "const": true }, "assessment_id": { "$ref": "#/components/schemas/AssessmentId" } }
      },
      "IntegrationStatus": {
        "type": "object",
        "required": ["merchant_id", "livemode", "all_passed", "checks", "recent_events"],
        "properties": {
          "merchant_id": { "$ref": "#/components/schemas/MerchantId" },
          "livemode": { "type": "boolean" },
          "all_passed": { "type": "boolean" },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status", "detail", "checked_at"],
              "properties": {
                "id": { "type": "string", "enum": ["key_valid", "tag_seen", "token_issued", "pay_event_seen", "assess_called", "assess_headers", "assess_latency", "webhook_delivered", "domain_verified"] },
                "status": { "type": "string", "enum": ["pass", "fail", "pending", "not_applicable"] },
                "detail": { "type": "string" },
                "checked_at": { "$ref": "#/components/schemas/Timestamp" }
              }
            }
          },
          "recent_events": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["type", "at", "origin"],
              "properties": { "type": { "type": "string" }, "at": { "$ref": "#/components/schemas/Timestamp" }, "origin": { "type": ["string", "null"] } }
            }
          }
        }
      },
      "EventEnvelope": {
        "type": "object",
        "required": ["id", "type", "created_at", "livemode", "merchant_id", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9]{20}$" },
          "type": { "type": "string", "enum": ["assessment.updated", "checkout.agent_started"] },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "livemode": { "type": "boolean" },
          "merchant_id": { "$ref": "#/components/schemas/MerchantId" },
          "data": { "type": "object" }
        }
      },
      "AssessmentUpdatedEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/EventEnvelope" },
          {
            "type": "object",
            "properties": {
              "type": { "const": "assessment.updated" },
              "data": {
                "type": "object",
                "required": ["assessment", "previous"],
                "properties": {
                  "assessment": { "$ref": "#/components/schemas/Assessment" },
                  "previous": {
                    "type": ["object", "null"],
                    "required": ["driver", "decision"],
                    "properties": { "driver": { "$ref": "#/components/schemas/Driver" }, "decision": { "type": "string", "enum": ["allow", "confirm", "block"] } }
                  }
                }
              }
            }
          }
        ]
      },
      "CheckoutAgentStartedEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/EventEnvelope" },
          {
            "type": "object",
            "properties": {
              "type": { "const": "checkout.agent_started" },
              "data": {
                "type": "object",
                "required": ["visit_id", "page", "at", "driver", "agent"],
                "properties": {
                  "visit_id": { "type": "string", "pattern": "^vis_[A-Za-z0-9]{20}$" },
                  "page": { "type": ["string", "null"] },
                  "at": { "$ref": "#/components/schemas/Timestamp" },
                  "driver": { "$ref": "#/components/schemas/Driver" },
                  "agent": { "oneOf": [{ "$ref": "#/components/schemas/Agent" }, { "type": "null" }] }
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "request_id"],
            "properties": {
              "code": { "type": "string", "enum": ["invalid_request", "invalid_key", "wrong_key_type", "key_revoked", "merchant_mismatch", "origin_not_allowed", "not_found", "idempotency_conflict", "rate_limited", "internal_error"] },
              "message": { "type": "string" },
              "request_id": { "type": "string" }
            }
          }
        }
      }
