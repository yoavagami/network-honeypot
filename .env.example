# Copy to .env and fill in real values. Never commit .env. See docs/SECURITY.md §3.

# --- Postgres (superuser, used only for migrations/seeding and by the postgres container itself)
POSTGRES_SUPERUSER=honeypot_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
POSTGRES_DB=honeypot

# --- Scoped, least-privilege app roles (see migrations/0001_init.sql GRANTs)
HONEYPOT_DB_PASSWORD=change-me-honeypot-role-password
ADMIN_API_DB_PASSWORD=change-me-admin-api-role-password
# Scoped to the synthetic CRM tables only, SELECT-only — see migrations/0005_crm_customers.sql
HONEYPOT_CRM_DB_PASSWORD=change-me-crm-role-password
# Feature flag for the deliberately vulnerable CRM search endpoint — see docs/VULNERABILITY.md.
# Leave false unless you've deliberately decided to run the real-vulnerability experiment.
CRM_SEARCH_VULNERABLE=false
# Feature flag for the backdoor/webshell bait paths — see docs/VULNERABILITY.md. When false,
# hitting these paths behaves exactly like any other unknown path (plain 404).
BACKDOOR_BAIT_ENABLED=false

# --- Superuser connection string used by `pnpm migrate` / `pnpm seed` (run from the host, not
# inside a container, against the locally-published dev Postgres — see DEPLOYMENT.md §2)
DATABASE_URL=postgres://honeypot_owner:change-me-superuser-password@localhost:5433/honeypot

# --- Honeypot app
IP_HASH_SECRET=change-me-32-byte-random-secret
COOKIE_SECRET=change-me-32-byte-random-secret

# --- Admin API
SESSION_SECRET=change-me-32-byte-random-secret
ADMIN_WEB_ORIGIN=http://localhost:8081
ADMIN_API_PUBLIC_URL=http://localhost:8090

# --- Seed script (optional — if unset, a random admin password is generated and printed once)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- Retention / privacy (see docs/PRIVACY.md)
RAW_IP_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=90
GEOLOCATION_ENABLED=false
# Required only if GEOLOCATION_ENABLED=true — free token from https://ipinfo.io (50k lookups/mo
# free tier; enrichment is cached per-actor, not per-request, see apps/honeypot/src/ingestion/enrichment.ts)
IPINFO_TOKEN=

# --- Alerting (see docs/ROADMAP.md Phase 2, apps/honeypot/src/ingestion/alerts.ts) — all
# optional; alerts are always recorded as ALERT_TRIGGERED events regardless of delivery config.
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_COOLDOWN_MS=900000
ALERT_HIGH_REQUEST_RATE_THRESHOLD=100
ALERT_AUTH_FAILURE_THRESHOLD=20
ALERT_ENUMERATION_THRESHOLD=50

LOG_LEVEL=info
