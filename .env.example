# Copy to .env and fill in real values. Never commit .env. See docs/SECURITY.md §3.

# --- Postgres (superuser, used only for migrations/seeding and by the postgres container itself)
POSTGRES_SUPERUSER=honeypot_owner
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
POSTGRES_DB=honeypot

# --- Scoped, least-privilege app roles (see migrations/0001_init.sql GRANTs)
HONEYPOT_DB_PASSWORD=change-me-honeypot-role-password
ADMIN_API_DB_PASSWORD=change-me-admin-api-role-password
# Scoped to the synthetic CRM tables only, SELECT-only — see migrations/0005_crm_customers.sql
HONEYPOT_CRM_DB_PASSWORD=change-me-crm-role-password
# Feature flag for the deliberately vulnerable CRM search endpoint — see docs/VULNERABILITY.md.
# Leave false unless you've deliberately decided to run the real-vulnerability experiment.
CRM_SEARCH_VULNERABLE=false
# Feature flag for the backdoor/webshell bait paths — see docs/VULNERABILITY.md. When false,
# hitting these paths behaves exactly like any other unknown path (plain 404).
BACKDOOR_BAIT_ENABLED=false
# Feature flag for the fake WordPress install-takeover bait — see docs/VULNERABILITY.md. When
# false, /wp-admin/install.php and /wp-login.php aren't registered at all (plain 404).
WP_INSTALL_BAIT_ENABLED=false

# --- Superuser connection string used by `pnpm migrate` / `pnpm seed` (run from the host, not
# inside a container, against the locally-published dev Postgres — see DEPLOYMENT.md §2)
DATABASE_URL=postgres://honeypot_owner:change-me-superuser-password@localhost:5433/honeypot

# --- Honeypot app
IP_HASH_SECRET=change-me-32-byte-random-secret
COOKIE_SECRET=change-me-32-byte-random-secret
# Signs/verifies ?lab= links (shared by honeypot and admin-api). Unset: lab labels are "claimed" only.
LAB_LINK_SECRET=change-me-32-byte-random-secret
# Visit scoring worker (apps/honeypot/src/scoring/visitScorer.ts)
SCORER_ENABLED=true
SCORER_INTERVAL_MS=30000

# --- Admin API
SESSION_SECRET=change-me-32-byte-random-secret
ADMIN_WEB_ORIGIN=http://localhost:8081
ADMIN_API_PUBLIC_URL=http://localhost:8090
# Public site URL, so lab links minted on the dashboard are clickable (e.g. https://uhoney.shop)
PUBLIC_SITE_URL=

# --- Seed script (optional — if unset, a random admin password is generated and printed once)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- Retention / privacy (see docs/PRIVACY.md)
RAW_IP_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=90
GEOLOCATION_ENABLED=false
# Required only if GEOLOCATION_ENABLED=true — free token from https://ipinfo.io (50k lookups/mo
# free tier; enrichment is cached per-actor, not per-request, see apps/honeypot/src/ingestion/enrichment.ts)
IPINFO_TOKEN=

# Stripe TEST MODE checkout (apps/honeypot/src/shop/stripeTest.ts). Only sk_test_/rk_test_ and
# pk_test_ keys are accepted — live keys disable the provider. Stripe Dashboard → Developers →
# API keys, with "Test mode" on. Empty = the built-in fake test-card form is used instead.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
# Optional order override, e.g. stripe_test,test_card,bank_transfer
SHOP_PAYMENT_PROVIDERS=

# --- Alerting (see docs/ROADMAP.md Phase 2, apps/honeypot/src/ingestion/alerts.ts) — all
# optional; alerts are always recorded as ALERT_TRIGGERED events regardless of delivery config.
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_COOLDOWN_MS=900000
ALERT_HIGH_REQUEST_RATE_THRESHOLD=100
ALERT_AUTH_FAILURE_THRESHOLD=20
ALERT_ENUMERATION_THRESHOLD=50

LOG_LEVEL=info

# --- Merchant platform (apps/merchant-api, docs/merchant/OPERATIONS.md)
# Database roles in the separate "merchant" database (created by the merchant migration).
MERCHANT_APP_DB_PASSWORD=change-me-merchant-app-password
MERCHANT_ADMIN_DB_PASSWORD=change-me-merchant-admin-password
# openssl rand -hex 32 for each. Never rotate MERCHANT_ENCRYPTION_KEY casually: stored webhook
# secrets become unreadable. Rotating MERCHANT_TOKEN_SECRET ends every visitor session.
MERCHANT_TOKEN_SECRET=change-me-64-hex
MERCHANT_ENCRYPTION_KEY=change-me-64-hex
# Shared by merchant-api and admin-api (admin Merchants pages).
MERCHANT_INTERNAL_TOKEN=change-me-64-hex
# Public URLs shown in docs, snippets and invite links.
MERCHANT_PUBLIC_API_URL=http://localhost:8095
MERCHANT_TAG_BASE_URL=http://localhost:8095
MERCHANT_DASHBOARD_URL=http://localhost:8081
# Local dev over plain http needs this false (cookies are Secure otherwise).
MERCHANT_COOKIE_SECURE=false
# Superuser URL for `pnpm --filter @honeypot/merchant-db migrate` from the host.
MERCHANT_MIGRATE_URL=postgres://honeypot_owner:change-me-superuser-password@localhost:5433/merchant

# --- Merchant site alerts (apps/merchant-api/src/siteAlerts.ts) — optional. Agent-file reads,
# developer-guide opens and access requests always appear in the admin dashboard (Merchants →
# Site alerts). MERCHANT_ALERT_URL also pushes them: a Slack incoming webhook, or an ntfy topic URL
# (https://ntfy.sh/<long random topic>, then subscribe in the ntfy phone app). Alerts include the
# visitor's IP, so use a topic nobody can guess.
MERCHANT_ALERT_URL=
# Your own IPs or ranges, comma-separated (for example 203.0.113.7, 198.51.100.0/24): no alerts.
MERCHANT_ALERT_IGNORE_IPS=
